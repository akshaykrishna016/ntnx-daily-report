# Copy to ".env" in this directory and fill in the real secrets.
# The .env file is parsed manually at startup (no python-dotenv dependency).
# NEVER commit the real .env to version control.

# Prism Central read-only service-account password (required for live runs).
PC_PASSWORD=changeme

# Mail relay password. Only needed when smtp.username is set in config.yaml.
# Leave unset for an anonymous relay.
SMTP_PASSWORD=
